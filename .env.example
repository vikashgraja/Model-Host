# Model-Host Environment Configuration

# Server bind settings
HOST=127.0.0.1
PORT=8434

# LLM GGUF Model Path (can point to any .gguf file or directory)
LLM_MODEL_PATH=./models/Llama-3.2-1B-Instruct-Q4_K_M.gguf

# Whisper Configuration
# Model size/folder: "tiny", "base", "small", "medium", or "./models/whisper-base"
WHISPER_MODEL_SIZE=base
 
# Whisper Device: "cpu" (recommended to prevent GPU VRAM contention) or "cuda"
WHISPER_DEVICE=cpu
